# Copy to .env; scripts/start.ps1 loads these values without executing the file.
KNOWLEDGE_DB=data/knowledge.sqlite3
# Optional OpenAI-compatible Chat Completions base URL, including /v1.
# Blank settings leave the default real local retrieval mode fully usable.
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
MODEL_TIMEOUT=30
MODEL_MAX_STEPS=6
# Optional real embeddings endpoint; appended path is /embeddings.
# No configuration means BM25 only. No synthetic vectors are generated.
EMBEDDING_BASE_URL=
EMBEDDING_NAME=
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT=30
EMBEDDING_MIN_SIMILARITY=0.5
